{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "preview",
      "channel": "preview",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6788189154"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6788189154"
      }
    }
  }
}
